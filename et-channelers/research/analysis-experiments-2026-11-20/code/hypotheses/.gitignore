# Synthetic simulation outputs are large and rebuilt by run.py; only the summary tables are tracked.
__pycache__/
sim_out/*
!sim_out/simulation-results-quick.json
!sim_out/simulation-results-quick.md
!sim_out/h6-cluster-reference-levels.md
!sim_out/h6-cluster-reference-levels.json
!sim_out/h6-pipeline-levels-1252.json
!sim_out/simulation-results.json
!sim_out/simulation-results.md
