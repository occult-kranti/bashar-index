{
  "manifest_version": 3,
  "name": "Channel Research Audio Capture",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Record a user-activated YouTube tab to the local research archive with source and coverage checks.",
  "key": "",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8768/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "Start research capture in this tab; click again to stop"},
  "options_page": "status.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8768"}
}
